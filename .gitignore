# ------------------------------------------
# Build directories and generated binaries
# ------------------------------------------
build/
bin/
obj/
Debug/
Release/
debug/
release/

# ------------------------------------------
# Compiled object and dependency files
# ------------------------------------------
*.o
*.obj
*.d
*.lo
*.la

# ------------------------------------------
# Executables and libraries
# ------------------------------------------
*.exe
*.out
*.elf
*.so
*.so.*
*.a
*.lib
*.dll
*.dylib

# ------------------------------------------
# Debugging and profiling
# ------------------------------------------
*.core
core
core.*
*.map
*.sym
*.pdb
*.prof
*.gcda
*.gcno
*.gcov
*.trace

# ------------------------------------------
# Logs and runtime output
# ------------------------------------------
*.log
*.log.*
*.pid
*.seed

# ------------------------------------------
# Temporary and backup files
# ------------------------------------------
*.tmp
*.temp
*.bak
*.backup
*.old
*.orig
*.rej
*.swp
*.swo
*~
.#*
#*#

# ------------------------------------------
# QNX / Momentics generated files
# ------------------------------------------
.qnx/
.metadata/
*.launch
.settings/
*.workspace
*.project
*.cdtbuild
*.cdtproject

# ------------------------------------------
# IDE and editor files
# ------------------------------------------
.vscode/
.idea/
*.iml
*.sublime-workspace
*.sublime-project

# ------------------------------------------
# Operating system files
# ------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
desktop.ini
.Trash-*

# ------------------------------------------
# Python scripts / visualization
# ------------------------------------------
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.venv/
venv/
env/

# ------------------------------------------
# MATLAB generated files
# ------------------------------------------
*.asv
*.m~
slprj/
codegen/

# ------------------------------------------
# Archive files
# ------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# ------------------------------------------
# Local environment and secrets
# ------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials/

# ------------------------------------------
# Keep project documentation and source files
# ------------------------------------------
!README.md
!Makefile
!include/
!src/
!*.c
!*.h
